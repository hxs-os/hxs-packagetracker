#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=glib
pkgver=2.90.1
pkgsrc=https://download.gnome.org/sources/glib/2.90/glib-$pkgver.tar.xz
pkgchecksum=sha256:93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396
pkgdesc="a general-purpose, portable utility library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="LGPL-2.1-or-later"
pkghomepage="https://docs.gtk.org/glib/"
pkgcheck=false
pkgdeps="musl,util-linux"

build() {
    meson setup build ${MESONFLAGS:-} \
        --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libdir=lib --buildtype=release -Dselinux=disabled \
        -Dtests=false -Dnls=disabled -Dman-pages=disabled \
        -Dman=false -Dlibmount=enabled -Dlibelf=disabled \
        -Dglib_debug=disabled -Ddocumentation=false \
        -Ddtrace=disabled
    meson compile -C build
}

package() {
    "${1:-fakeroot}" meson install -C build --strip --destdir "$pkgdir"
}
