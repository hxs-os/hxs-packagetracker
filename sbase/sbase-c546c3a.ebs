#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=sbase
pkgver=c546c3a
pkgsrc=https://main.hxs.juanvel400.com/source/s/sbase/sbase-$pkgver.tar.gz
pkgchecksum=sha256:da9b7ce12c0e773c9885d52be118e94dd0075b4b2676bd9b536645351a4a6405
pkgdesc="collection of unix tools"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://core.suckless.org/sbase/"
pkgcheck=false
pkgdeps="musl"
pkgprovides="system:coreutils"
pkgtriggers="man"

build() {
    sed -i 's|^PREFIX = /usr/local$|PREFIX = /usr|' config.mk
    make
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
