#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=freetype
pkgver=2.15.0
pkgsrc=https://download.savannah.gnu.org/releases/freetype/freetype-$pkgver.tar.xz
pkgchecksum=sha256:93cd47eb719c325107f2d3cf087d06299e944c3b48a40b55537302304dea1dd5
pkgdesc="font rendering software library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="FTL AND GPL-2.0-or-later"
pkghomepage="https://freetype.org/"
pkgcheck=true
pkgdeps="musl,zlib,bzip2"

build() {
    meson setup build ${MESONFLAGS:-} \
        --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libdir=lib --buildtype=release -Dzlib=enabled -Dpng=disabled \
        -Dbzip2=enabled -Dbrotli=disabled -Dhvf=disabled -Dharfbuzz=disabled \
        -Dtests=enabled
    meson compile -C build
}

check() {
    meson test -C build
}

package() {
    "${1:-fakeroot}" meson install -C build --strip --destdir "$pkgdir"
}
