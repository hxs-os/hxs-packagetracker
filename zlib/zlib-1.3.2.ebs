#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154

#ebs.formulae
ebsver=1

pkgname=zlib
pkgver=1.3.2
pkgsrc=https://zlib.net/zlib-$pkgver.tar.xz
pkgchecksum=sha256:d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3
pkgdesc="a lossless data-compression library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="Zlib"
pkghomepage="https://zlib.net"
pkgcheck=true

build() {
    ./configure --prefix=/usr
    make
}

check() {
    make check
}

package() {
    $1 make install DESTDIR="$pkgdir"
}
