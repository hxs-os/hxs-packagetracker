#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=libcap
pkgver=2.78
pkgsrc=https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-$pkgver.tar.xz
pkgchecksum=sha256:0d621e562fd932ccf67b9660fb018e468a683d7b827541df27813228c996bb11
pkgdesc="linux capabilities library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD-3-Clause OR GPL-2.0-or-later"
pkghomepage="https://git.kernel.org/pub/scm/libs/libcap/libcap.git/"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man"

build() {
    make GOLANG=no
}

check() {
    make test GOLANG=no
}

package() {
    "${1:-fakeroot}" make install \
        prefix=/usr lib=lib SBINDIR=/usr/sbin \
        libdir=/usr/lib DESTDIR="$pkgdir" GOLANG=no
}
