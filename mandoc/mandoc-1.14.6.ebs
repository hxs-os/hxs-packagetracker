#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=mandoc
pkgver=1.14.6
pkgsrc=https://mandoc.bsd.lv/snapshots/mandoc-$pkgver.tar.gz
pkgchecksum=sha256:8bf0d570f01e70a6e124884088870cbed7537f36328d512909eb10cd53179d9c
pkgdesc="a suite of tools for manual pages"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="ISC"
pkghomepage="https://mandoc.bsd.lv/"
pkgcheck=true
pkgprovides="man,triggers:man"
pkgtriggers="man"

build() {
    echo "PREFIX=/usr" > ./configure.local
    echo "MANDIR=/usr/share/man" >> ./configure.local
    echo "BINDIR=/usr/bin" >> ./configure.local
    echo "SBINDIR=/usr/sbin" >> ./configure.local
    echo "OSNAME=\"HxS\"" >> ./configure.local
    echo "OSENUM=MANDOC_OS_OTHER" >> ./configure.local
    echo "CFLAGS=\"${CFLAGS:--O2}\"" >> ./configure.local
    echo "LDFLAGS=\"${LDFLAGS:-}\"" >> ./configure.local
    ./configure
    make
}

check() {
    make regress
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"

    mkdir -p "$pkgdir/usr/share/xpt/triggers"

    cat >"$pkgdir/usr/share/xpt/triggers/man" <<'EOF'
#!/bin/sh

set -e

# xpt: man trigger
# refreshes the manual page database
command -v makewhatis >/dev/null || exit 0
makewhatis "${XPT_ROOT:-}/usr/share/man"
EOF

    chmod +x "$pkgdir/usr/share/xpt/triggers/man"

}
