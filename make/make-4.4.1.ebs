#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=make
pkgver=4.4.1
pkgsrc=https://ftp.gnu.org/gnu/make/make-$pkgver.tar.gz
pkgchecksum=sha256:dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3
pkgdesc="GNU make"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-3.0-or-later"
pkghomepage="https://www.gnu.org/software/make"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man,info"

build() {
    CFLAGS="${CFLAGS:--std=gnu17}" ./configure ${CONFIGUREFLAGS:-} \
        --prefix=/usr --disable-rpath --enable-year2038 \
        --without-guile
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
    rm -f "$pkgdir/usr/share/info/dir"
}
