#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=adam.static
pkgver=0.1.0
pkgsrc=https://dl.juanvel400.com/adam/adam-$pkgver.tar.xz
pkgchecksum=sha256:a9f98d24a9e5d3f219ccd0f9cd1ee97d1eadcc7d86a4be8f28f4d4f4b1f6b003
pkgdesc="a static build of adam"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD-3-Clause"
pkghomepage="https://sr.ht/~juanvel400/adam"
pkgcheck=false
pkgprovides="system:init,adam"
pkgtriggers="man"

build() {
    meson setup build ${MESONFLAGS:-} --prefix=/usr --sysconfdir=/etc --localstatedir=/var --buildtype=release -Dstatic=true
    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" "${1:-fakeroot}" meson install -C build --strip
}
