#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154

#ebs.formulae
ebsver=1

pkgname=adam.static
pkgver=0.2.0
pkgsrc=https://dl.juanvel400.com/adam/adam-$pkgver.tar.xz
pkgchecksum=sha256:2d45b13c91f9a63543d124885645fd9c05d946415002017b1be566bcb7c1cc3c
pkgdesc="a static build of adam"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD-3-Clause"
pkghomepage="https://sr.ht/~juanvel400/adam"
pkgprovides="system:init,adam"

build() {
    meson setup build --prefix=/usr --sysconfdir=/etc --localstatedir=/var --buildtype=release -Dstatic=true
    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" "${1:-fakeroot}" meson install -C build --strip
}
