#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=mksh
pkgver=R59c
pkgsrc=https://mbsd.evolvis.org/MirOS/dist/mir/mksh/mksh-$pkgver.tgz
pkgchecksum=sha256:77ae1665a337f1c48c61d6b961db3e52119b38e58884d1c89684af31f87bc506
pkgdesc="the MirBSD Korn Shell"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MirOS AND ISC"
pkghomepage="http://www.mirbsd.org/mksh.htm"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man"

build() {
    sh ./Build.sh ${BUILDFLAGS:-} -r
}

check() {
    sh ./test.sh
}

package() {
    install -d -m 755 "$pkgdir/usr/bin" \
        "$pkgdir/usr/share/man/man1"

    install -m 755 mksh "$pkgdir/usr/bin/mksh"
    install -m 644 lksh.1 mksh.1 "$pkgdir/usr/share/man/man1"

    mkdir -p "$pkgdir/usr/share/shells.d"
    printf "/usr/bin/mksh\n/bin/mksh\n" >"$pkgdir/usr/share/shells.d/mksh"
}
