#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=mpc
pkgver=1.4.1
pkgsrc=https://ftp.gnu.org/gnu/mpc/mpc-$pkgver.tar.xz
pkgchecksum=sha256:91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931
pkgdesc="multiple precision complex arithmetic library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-3.0-or-later"
pkghomepage="https://www.multiprecision.org/"
pkgcheck=true
pkgdeps="musl,gmp,mpfr"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr --disable-rpath --enable-year2038
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
