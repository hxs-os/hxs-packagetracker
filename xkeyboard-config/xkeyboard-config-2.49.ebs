#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=xkeyboard-config
pkgver=2.49
pkgsrc=https://gitlab.freedesktop.org/xkeyboard-config/xkeyboard-config/-/archive/xkeyboard-config-$pkgver/xkeyboard-config-xkeyboard-config-$pkgver.tar.gz
pkgchecksum=sha256:deda99f75a41532db85661cac01793c9b48b5e68a78ecd259fe8b3a7d8fddd61
pkgdesc="reference database of keyboard configuration data"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://xkeyboard-config.freedesktop.org/"
pkgcheck=true
pkgdeps="musl,libxkbcommon"

build() {
    meson setup build ${MESONFLAGS:-} \
        --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libdir=lib --buildtype=release -Dnls=false
    meson compile -C build
}

check() {
    meson test -C build
}

package() {
    "${1:-fakeroot}" meson install -C build --strip --destdir "$pkgdir"
}
