#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=mpfr
pkgver=4.2.2
pkgsrc=https://ftp.gnu.org/gnu/mpfr/mpfr-$pkgver.tar.xz
pkgchecksum=sha256:b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01
pkgdesc="multiple-precision floating-point computations library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-3.0-or-later"
pkghomepage="https://mpfr.org"
pkgcheck=true
pkgdeps="musl,gmp"
pkgprovides="libmpfr"
pkgtriggers="info"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
    rm -f "$pkgdir/usr/share/info/dir"
}
