#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=libxml2
pkgver=2.15.4
pkgsrc=https://download.gnome.org/sources/libxml2/2.15/libxml2-$pkgver.tar.xz
pkgchecksum=sha256:98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821
pkgdesc="libraries and utilities used to parse XML files"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://gitlab.gnome.org/GNOME/libxml2"
pkgcheck=true
pkgdeps="musl"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr \
        --sysconfdir=/etc --localstatedir=/var
    make
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
