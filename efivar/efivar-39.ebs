#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=efivar
pkgver=39
pkgsrc=https://github.com/rhboot/efivar/archive/$pkgver/efivar-$pkgver.tar.gz
pkgchecksum=sha256:c9edd15f2eeeea63232f3e669a48e992c7be9aff57ee22672ac31f5eca1609a6
pkgdesc="tools and libraries to manipulate EFI variables"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="LGPL-2.1-or-later"
pkghomepage="https://github.com/rhboot/efivar/"
pkgcheck=false
pkgdeps="musl,mandoc"
pkgtriggers="man"

build() {
    make
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir" LIBDIR="/usr/lib"
}
