#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=fakeroot
pkgver=2.1.4
pkgsrc=https://deb.debian.org/debian/pool/main/f/fakeroot/fakeroot_$pkgver.orig.tar.xz
pkgchecksum=sha256:0822bd5a9f0cf19d2ba0546b88b0432d4d3d9917db62c57b74044ccadba06e49
pkgdesc="gives a fake root environment for package building"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD-3-Clause"
pkghomepage="https://wiki.debian.org/FakeRoot"
pkgcheck=false
pkgdeps="musl"
pkgtriggers="man"

prepare() {
    ./bootstrap ${BOOTSTRAPFLAGS:-}
}

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
