#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=utf8proc
pkgver=2.12.0
pkgsrc=https://github.com/JuliaStrings/utf8proc/releases/download/v$pkgver/utf8proc-$pkgver.tar.gz
pkgchecksum=sha256:a393fbef160835fb315bc3e91ba8d86f7a73a7cec9e6198b6c60b848b498bfeb
pkgdesc="a small, clean C library that provides Unicode processing"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://juliastrings.github.io/utf8proc/"
pkgcheck=false
pkgdeps="musl"
pkgprovides="libutf8proc"

build() {
    make prefix=/usr
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir" prefix=/usr
}
