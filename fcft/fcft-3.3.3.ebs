#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=fcft
pkgver=3.3.3
pkgsrc=https://codeberg.org/dnkl/fcft/releases/download/$pkgver/fcft-$pkgver.tar.gz
pkgchecksum=sha256:bb298772d625e7d917373d541456f34f1957a9e22b16f17f64158b2c3816563c
pkgdesc="a simple library for font loading and glyph rasterization"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://codeberg.org/dnkl/fcft"
pkgcheck=true
pkgdeps="musl,freetype,fontconfig,pixman,tllist"
pkgprovides="libfcft"

build() {
    meson setup build ${MESONFLAGS:-} \
        --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libdir=lib --buildtype=release -Dsystem-nanosvg=disabled \
        -Ddocs=disabled
    meson compile -C build
}

check() {
    meson test -C build
}

package() {
    "${1:-fakeroot}" meson install -C build --strip --destdir "$pkgdir"
}
