#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=kmod
pkgver=34.2
pkgsrc=https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-$pkgver.tar.xz
pkgchecksum=sha256:5a5d5073070cc7e0c7a7a3c6ec2a0e1780850c8b47b3e3892226b93ffcb9cb54
pkgdesc="utilities to load and manage Linux kernel modules"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://git.kernel.org/pub/scm/utils/kernel/kmod/kmod.git"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --enable-year2038
    sed 's|--force --relative $(DESTDIR)$(bindir)/kmod|-f ../bin/kmod|' Makefile > Makefile.new
    mv Makefile.new Makefile
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
