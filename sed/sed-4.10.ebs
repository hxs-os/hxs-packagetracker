#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=sed
pkgver=4.10
pkgsrc=https://ftp.gnu.org/gnu/sed/sed-$pkgver.tar.xz
pkgchecksum=sha256:b8e72182b2ec96a3574e2998c47b7aaa64cc20ce000d8e9ac313cc07cecf28c7
pkgdesc="non-interactive command line editor"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-3.0-or-later"
pkghomepage="https://www.gnu.org/software/sed"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man,info"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr --disable-rpath --enable-year2038
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
    rm -f "$pkgdir/usr/share/info/dir"
}
