#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=toybox
pkgver=0.8.15
pkgsrc=https://landley.net/toybox/downloads/toybox-$pkgver.tar.gz
pkgchecksum=sha256:44e2bab43dfe2c171743297631ce558c6d9ed38b87a66fd751cef617574b375e
pkgdesc="common Linux command-line utilities bundled in a single binary"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkghomepage="https://landley.net/toybox/"
pkglicense="0BSD"
pkgcheck=true
pkgdeps="musl"

prepare() {
    cp "$filesdir/config-$pkgver" ".config"
}

build() {
    make
}

check() {
    make test
}

package() {
    mkdir -p "$pkgdir/usr/bin"
    install -m755 toybox "$pkgdir/usr/bin/toybox"
}
