#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=pxbase.static
pkgver=0.5.0
pkgsrc=https://dl.juanvel400.com/pxbase/pxbase-$pkgver.tar.xz
pkgchecksum=sha256:ce8a5da79de1bb881eba348443ad557839f10b104d15f4769f22ed9fa8f0e4f8
pkgdesc="(f.k.a hbase) a static and multicall build of pxbase"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD-3-Clause"
pkghomepage="https://sr.ht/~juanvel400/pxbase"
pkgcheck=false
pkgprovides="system:coreutils,pxbase"
pkgtriggers="man"

build() {
    meson setup build ${MESONFLAGS:-} --buildtype=release --prefix=/usr -Ddoc=enabled -Dstatic=true -Dmulticall=enabled
}

package() {
    "${1:-fakeroot}" meson install -C build --strip --destdir "$pkgdir"
}
