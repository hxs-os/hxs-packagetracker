#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=libevent
pkgver=2.1.13
pkgsrc=https://github.com/libevent/libevent/releases/download/release-$pkgver-stable/libevent-$pkgver-stable.tar.gz
pkgchecksum=sha256:f7e9383b8c0baa81b687e5b5eecc01beefaf1b19b64151d95ed61647fe7a315c
pkgdesc="asynchronous event notification library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD-3-Clause"
pkghomepage="https://libevent.org/"
pkgcheck=true
pkgdeps="musl,openssl"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr \
        --sysconfdir=/etc --localstatedir=/var \
        --enable-year2038 --disable-debug-mode
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
