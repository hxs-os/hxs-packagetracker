#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=pcre2
pkgver=10.49
pkgsrc=https://github.com/PCRE2Project/pcre2/releases/download/pcre2-$pkgver/pcre2-$pkgver.tar.gz
pkgchecksum=sha256:929f0b20e62879252a15886b06c89f1edef61a363cbd5826fb041080a5e557ae
pkgdesc="a library implementing regular expression pattern matching"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD-3-Clause WITH PCRE2-exception"
pkghomepage="http://www.pcre2.org/"
pkgcheck=true
pkgdeps="musl"
pkgprovides="libpcre2"
pkgtriggers="man"

build() {
    ./configure ${CONFIGUREFLAGS:-} \
        --prefix=/usr --sysconfdir=/etc --localstatedir=/var
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
