#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=python-wheel
pkgver=0.48.0
pkgsrc=https://files.pythonhosted.org/packages/source/w/wheel/wheel-$pkgver.tar.gz
pkgchecksum=sha256:94800765601e9171bf5d58d066e640662842bcedcbab982b2c90787a2c987322
pkgdesc="built-package format for Python distributions"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://pypi.org/project/wheel/"
pkgcheck=false
pkgdeps="python"

build() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

package() {
    "${1:-fakeroot}" pip3 install --no-index --no-deps --ignore-installed --no-compile --find-links dist --prefix=/usr --root "$pkgdir" wheel
}
