#!/bin/sh

# the binutils formula uses {TARGET,HOST,BUILD}_TRIPLE variables to support both
# Canadian cross-compilation and native builds

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=binutils
pkgver=2.47
pkgsrc=https://ftp.gnu.org/gnu/binutils/binutils-$pkgver.tar.xz
pkgchecksum=sha256:154ab23b60070e8f27013c22977f1129425d67d1e8acd6e13010e617811e4cff
pkgdesc="GNU collection of binary tools"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-3.0-or-later"
pkghomepage="https://www.gnu.org/software/binutils"
pkgcheck=true
pkgdeps="musl,zlib"
pkgtriggers="man,info"

_triple="${TARGET_TRIPLE:-$(cc -dumpmachine)}"

prepare() {
    sed '6031s/$add_dir//' ltmain.sh >ltmain.sh.tmp
    mv ltmain.sh.tmp ltmain.sh
}

build() {

    mkdir build
    cd build || return 1

    ../configure ${CONFIGUREFLAGS:-} \
        --prefix=/usr --enable-static \
        --disable-rpath --enable-year2038 \
        --with-system-zlib --disable-werror \
        --with-system-getopt --enable-shared \
        --build="${BUILD_TRIPLE:-${_triple}}" \
        --host="${HOST_TRIPLE:-${_triple}}" \
        --target="${TARGET_TRIPLE:-${_triple}}"
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
    rm -f "$pkgdir/usr/share/info/dir"
    rm -rf "$pkgdir/usr/${TARGET_TRIPLE:-${_triple}}"
}
