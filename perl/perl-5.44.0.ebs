#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=perl
pkgver=5.44.0
pkgsrc=https://www.cpan.org/src/5.0/perl-$pkgver.tar.gz
pkgchecksum=sha256:3b855066b92491cb40e86affb1ca57d1a388aa43e51b91c7806a32c2f65f96c3
pkgdesc="Perl programming language"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-1.0-or-later"
pkghomepage="https://www.perl.org"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man"


build() {
    sh Configure -des \
        -D prefix=/usr \
        -D vendorprefix=/usr \
        -D useshrplib \
        -D privlib=/usr/lib/perl5/$pkgver/core_perl \
        -D archlib=/usr/lib/perl5/$pkgver/core_perl \
        -D sitelib=/usr/lib/perl5/$pkgver/site_perl \
        -D sitearch=/usr/lib/perl5/$pkgver/site_perl \
        -D vendorlib=/usr/lib/perl5/$pkgver/vendor_perl \
        -D vendorarch=/usr/lib/perl5/$pkgver/vendor_perl \
        -Ud_eaccess
    make
}

check() {
    make test
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
