#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=tllist
pkgver=1.1.0
pkgsrc=https://codeberg.org/dnkl/tllist/releases/download/$pkgver/tllist-$pkgver.tar.gz
pkgchecksum=sha256:a1f0ce0dc4fcb4ce59c37202a1d914c853a8bd2d7c5d57d623b15a8dd9778767
pkgdesc="a C header file only implementation of a typed linked list"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://codeberg.org/dnkl/tllist"
pkgcheck=false
pkgdeps="musl"

build() {
    meson setup build ${MESONFLAGS:-} \
        --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libdir=lib --buildtype=release
    meson compile -C build
}

package() {
    "${1:-fakeroot}" meson install -C build --strip --destdir "$pkgdir"
}
