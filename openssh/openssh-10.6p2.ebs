#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=openssh
pkgver=10.6p2
pkgsrc=https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-$pkgver.tar.gz
pkgchecksum=sha256:9ae44872090cf2f06b3cf9ff147e7f16f309671340763ed2f99248398ae29d5b
pkgdesc="a suite of secure networking utilities based on the secure shell protocol"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD"
pkghomepage="https://www.openssh.org/"
pkgcheck=true
pkgtriggers="man"
pkgprovides="system:ssh"
pkgdeps="musl,openssl,zlib"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr --sysconfdir=/etc --localstatedir=/var --without-rpath
    make
}

check() {
    make tests
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"

    install -d "$pkgdir/usr/share/licenses/openssh"
    install -m 644 LICENCE "$pkgdir/usr/share/licenses/openssh/LICENCE"
}
