#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=iana-etc
pkgver=20261009
pkgsrc=https://github.com/Mic92/iana-etc/releases/download/$pkgver/iana-etc-$pkgver.tar.gz
pkgchecksum=sha256:c07e8ecc39d4d9f26be3bf773fab1313b1a3ea58ebed9fbcec2413ee792b6e6f
pkgdesc="/etc/protocols and /etc/services provided by IANA"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://github.com/Mic92/iana-etc"
pkgcheck=false

build() {
    :
}

package() {
    mkdir -p "$pkgdir/etc"
    cp services protocols "$pkgdir/etc"
}
