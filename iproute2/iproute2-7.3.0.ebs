#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=iproute2
pkgver=7.3.0
pkgsrc=https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-$pkgver.tar.xz
pkgchecksum=sha256:5c1789d290bba048a6135ed1ab81b0402dd0fb528d1f1421765c42b1fc3d6289
pkgdesc="set of utilities for Linux networking"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-2.0-or-later"
pkghomepage="https://wiki.linuxfoundation.org/networking/iproute2"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr --include_dir=/usr/include --libdir=/usr/lib \
        --libbpf_force=off
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir" PREFIX="/usr" SBINDIR="/usr/sbin" LIBDIR="/usr/lib"
}
