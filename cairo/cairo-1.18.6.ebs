#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=cairo
pkgver=1.18.6
pkgsrc=https://www.cairographics.org/releases/cairo-$pkgver.tar.xz
pkgchecksum=sha256:1c767308174337a74694da0f3ec069c271452163a1ef4540964c50c301f157d4
pkgdesc="a 2D graphics library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="LGPL-2.1-or-later OR MPL-1.1"
pkghomepage="https://www.cairographics.org/"
pkgcheck=true
pkgdeps="musl,zlib,fontconfig,freetype"
pkgprovides="libcairo"

build() {
    meson setup build ${MESONFLAGS:-} \
        --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libdir=lib --buildtype=release -Dzlib=enabled \
        -Dxlib=disabled -Dxcb=disabled -Dxlib-xcb=disabled \
        -Dpng=enabled -Dgtk_doc=false -Dgtk2-utils=disabled \
        -Dglib=disabled -Dfreetype=enabled -Dfontconfig=enabled \
        -Ddwrite=disabled
    meson compile -C build
}

check() {
    meson test -C build
}

package() {
    "${1:-fakeroot}" meson install -C build --strip --destdir "$pkgdir"
}
