#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=expat
pkgver=2.10.0
pkgsrc=https://github.com/libexpat/libexpat/releases/download/R_2_10_0/expat-$pkgver.tar.xz
pkgchecksum=sha256:c624ba2998fc65df1163a49641ff3f9ab73138b11641d92c86bee0fb01b1bc7f
pkgdesc="a stream-oriented XML parser library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://libexpat.github.io/"
pkgdeps="musl"
pkgtriggers="man"
pkgprovides="libexpat"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr \
        --sysconfdir=/etc --localstatedir=/var
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
