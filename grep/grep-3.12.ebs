#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=grep
pkgver=3.12
pkgsrc=https://ftp.gnu.org/gnu/grep/grep-$pkgver.tar.xz
pkgchecksum=sha256:2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9
pkgdesc="searches one or more files for patterns"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-3.0-or-later"
pkghomepage="https://www.gnu.org/software/grep"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man,info"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr --disable-rpath --enable-year2038
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
    rm -f "$pkgdir/usr/share/info/dir"
}
