#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=jq
pkgver=1.8.2
pkgsrc=https://github.com/jqlang/jq/releases/download/jq-$pkgver/jq-$pkgver.tar.gz
pkgchecksum=sha256:71b8d6e8f5fe81f6c6d0d110e3892251f6ce76ed095abd315e26e6e1193af3af
pkgdesc="command-line JSON processor"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://jqlang.org/"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man"
pkgprovides="libjq"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr \
        --sysconfdir=/etc --localstatedir=/var \
        --disable-decnum
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
