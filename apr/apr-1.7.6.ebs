#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=apr
pkgver=1.7.6
pkgsrc=https://archive.apache.org/dist/apr/apr-$pkgver.tar.gz
pkgchecksum=sha256:6a10e7f7430510600af25fabf466e1df61aaae910bf1dc5d10c44a4433ccc81d
pkgdesc="the Apache portable runtime"
pkgmaintainer="juanvel400 <me@juanvel400.com"
pkglicense="Apache-2.0"
pkghomepage="https://apr.apache.org/"
pkgcheck=true
pkgdeps="musl"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr \
        --with-installbuilddir=/usr/share/apr-1/build \
        --disable-static
    make
}

check() {
    make test
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
