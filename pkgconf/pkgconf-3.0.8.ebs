#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=pkgconf
pkgver=3.0.8
pkgsrc=https://github.com/pkgconf/pkgconf/releases/download/pkgconf-$pkgver/pkgconf-$pkgver.tar.xz
pkgchecksum=sha256:943f0bc88bcaeceb630b00262e2a8ad5ea4fac3fba72a4267d8b9ec6b35d1194
pkgdesc="package compiler and linker metadata toolkit"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="pkgconf"
pkghomepage="https://github.com/pkgconf/pkgconf"
pkgcheck=false
pkgprovides="pkg-config"
pkgdeps="musl"
pkgtriggers="man"


build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr
    make
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"

    ln -sf pkgconf "$pkgdir/usr/bin/pkg-config"
}
