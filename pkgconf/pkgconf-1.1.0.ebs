#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154

#ebs.formulae
ebsver=1

pkgname=pkgconf
pkgver=1.1.0
pkgsrc=https://distfiles.dereferenced.org/pkgconf/pkgconf-1.1.0.tar.xz
pkgchecksum=sha256:5f1ef65d73a880fa5e7012102a17f7b32010e5e46139aed85851a541ba828a63
pkgdesc="package compiler and linker metadata toolkit"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="pkgconf"
pkghomepage="https://pkgconf.org"
pkgcheck=false

build() {
    ./configure --prefix=/usr
    make
}

package() {
    fakeroot make install DESTDIR="$pkgdir"
}
