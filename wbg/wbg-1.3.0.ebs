#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=wbg
pkgver=1.3.0
pkgsrc=https://codeberg.org/dnkl/wbg/releases/download/$pkgver/wbg-$pkgver.tar.gz
pkgchecksum=sha256:5e23555c599e58f8fc76f2f8a697149c9fe96702a337a3e0457d503becb307a5
pkgdesc="super simple wallpaper application for wayland compositors"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://codeberg.org/dnkl/wbg"
pkgcheck=true
pkgdeps="musl,libpng,tllist,fcft,libjpeg"
pkgtriggers="man"

build() {
    meson setup build ${MESONFLAGS:-} \
        --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libdir=lib --buildtype=release -Dsystem-nanosvg=disabled \
        -Dpng=enabled -Dsvg=true -Djpeg=enabled -Dwebp=disabled
    meson compile -C build
}

check() {
    meson test -C build
}

package() {
    "${1:-fakeroot}" meson install -C build --strip --destdir "$pkgdir"
}
