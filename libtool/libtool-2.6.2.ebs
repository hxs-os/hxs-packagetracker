#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=libtool
pkgver=2.6.2
pkgsrc=https://ftpmirror.gnu.org/libtool/libtool-$pkgver.tar.gz
pkgchecksum=sha256:24adb3aa9ae035c70faba344af57d73215eb89281045af6c7ccd307751f8b0bf
pkgdesc="generic library support script"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-3.0-or-later"
pkghomepage="https://www.gnu.org/software/libtool"
pkgcheck=true
pkgdeps="musl,m4"
pkgtriggers="man"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
    rm -f "$pkgdir/usr/share/info/dir"
}
