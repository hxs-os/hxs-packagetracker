#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=sharbase.static
pkgver=0.2.0
pkgsrc=https://dl.juanvel400.com/sharbase/sharbase-$pkgver.tar.xz
pkgchecksum=sha256:d6dd85ebc8eeff9da43b934eddcd18abe89a9160e39870e69738cca30f6a0e6f
pkgdesc="a static build of sharbase"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD-3-Clause"
pkghomepage="https://sr.ht/~juanvel400/sharbase"
pkgcheck=false
pkgtriggers="man"

build() {
    meson setup build ${MESONFLAGS:-} --prefix=/usr --sysconfdir=/etc --localstatedir=/var --buildtype=release -Dstatic=true
    meson compile -C build
}

package() {
    "${1:-fakeroot}" meson install -C build --strip --destdir "$pkgdir"
}
