#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=libffi
pkgver=3.8.1
pkgsrc=https://github.com/libffi/libffi/releases/download/v$pkgver/libffi-$pkgver.tar.gz
pkgchecksum=sha256:81e879c094cc5ec3186c48510c6385ac6b3e866192e8bc71a35245703757ee40
pkgdesc="a portable foreign function interface library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://github.com/libffi/libffi/"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man,info"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
    rm "$pkgdir/usr/share/info/dir"
}
