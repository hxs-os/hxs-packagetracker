#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=popt
pkgver=1.19
pkgsrc=https://ftp.osuosl.org/pub/rpm/popt/releases/popt-1.x/popt-$pkgver.tar.gz
pkgchecksum=sha256:c25a4838fc8e4c1c8aacb8bd620edb3084a3d63bf8987fdad3ca2758c63240f9
pkgdesc="a command-line options parsing library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://github.com/rpm-software-management/popt"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr --disable-static
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
