#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=ubase.static
pkgver=e8249b4
pkgsrc=https://main.hxs.juanvel400.com/source/u/ubase/ubase-$pkgver.tar.gz
pkgchecksum=sha256:32b21897cd6fe0ceeee731cbb10040e0b2285fa756a4fe5dd1572adb47ca4f62
pkgdesc="a static build of ubase, using the ubase-box multicall binary"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="MIT"
pkghomepage="https://core.suckless.org/ubase/"
pkgcheck=false
pkgprovides="system:baseutils,ubase"
pkgtriggers="man"

build() {
    sed -i 's|^PREFIX = /usr/local$|PREFIX = /usr|' config.mk
    LDFLAGS="${LDFLAGS:-} -static" make ubase-box
}

package() {
    "${1:-fakeroot}" make ubase-box-install DESTDIR="$pkgdir"

    # overlapping with sbase
    rm -f "$pkgdir/usr/share/man/man1/mknod.1" "$pkgdir/usr/share/man/man1/dd.1" \
         "$pkgdir/usr/bin/mknod" "$pkgdir/usr/bin/dd"
}
