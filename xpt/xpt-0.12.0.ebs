#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=xpt
pkgver=0.12.0
pkgsrc=https://dl.juanvel400.com/xpt/xpt-$pkgver.tar.xz
pkgchecksum=sha256:9d9a2faa9f49acb91b09218f0e24574d0017917bdb32d3ac92ef93211e575476
pkgdesc="a package manager utility and library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD-3-Clause"
pkghomepage="https://git.sr.ht/~juanvel400/xpt"
pkgcheck=true
pkgdeps="musl,openssl,libarchive,zstd,sqlite3,pkgconf"
pkgprovides="system:xpt,libxpt"
pkgtriggers="man"

build() {
    meson setup build ${MESONFLAGS:-} -Dbuildtype=release -Dprefix=/usr -Ddoc=enabled -Dtests=enabled -Dwerror=false
}

check() {
    meson test -C build
}

package() {
    DESTDIR="$pkgdir" "${1:-fakeroot}" meson install -C build --strip
}
