#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=libisl
pkgver=0.28
pkgsrc=https://libisl.sourceforge.io/isl-$pkgver.tar.xz
pkgchecksum=sha256:3dc31b8e1b18329e42d5dfbf84dd55e15c59b61569a2ab246f61497d9592f727
pkgdesc="integer set library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-3.0-or-later"
pkghomepage="https://libisl.sourceforge.io"
pkgcheck=true
pkgdeps="musl,gmp"
pkgtriggers="man,info"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
    rm -f "$pkgdir/usr/share/info/dir"
}
