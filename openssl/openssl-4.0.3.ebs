#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=openssl
pkgver=4.0.3
pkgsrc=https://github.com/openssl/openssl/releases/download/openssl-$pkgver/openssl-$pkgver.tar.gz
pkgchecksum=sha256:325b5c806167c13b40b1ffeadfe0248197c00eccc4cf123ec1e28d2d2fd216d9
pkgdesc="robust, commercial-grade, full-featured, TLS toolkit"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="Apache-2.0"
pkghomepage="https://openssl-library.org/"
#pkgcheck=true
pkgdeps="zlib"
pkgprovides="system:ssl"

build() {
    ./Configure ${SSLCONFIGUREFLAGS:-} --prefix=/usr --openssldir=/etc/ssl --libdir=lib shared zlib-dynamic
    make
}

# check() {
#     make test
# }

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
