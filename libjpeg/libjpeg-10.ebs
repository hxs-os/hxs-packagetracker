#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=libjpeg
pkgver=10
pkgsrc=https://ijg.org/files/jpegsrc.v$pkgver.tar.gz
pkgchecksum=sha256:8b9eaa13242690ebd03e1728ab1edf97a81a78ed6e83624d493655f31ac95ab5
pkgdesc="JPEG manipulation library"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="IJG"
pkghomepage="https://ijg.org/"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr \
        --sysconfdir=/etc --localstatedir=/var
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
