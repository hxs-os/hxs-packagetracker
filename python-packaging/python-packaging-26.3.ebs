#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=python-packaging
pkgver=26.3
pkgsrc=https://files.pythonhosted.org/packages/source/p/packaging/packaging-$pkgver.tar.gz
pkgchecksum=sha256:94edc256424af38762eb31306eed28beb9f0efc50a8837492c9d6fd6004aed79
pkgdesc="core utilities for Python package metadata and version handling"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="Apache-2.0 OR BSD-2-Clause"
pkghomepage="https://pypi.org/project/packaging/"
pkgcheck=false
pkgdeps="python"

build() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

package() {
    "${1:-fakeroot}" pip3 install --no-index --no-deps --ignore-installed --no-compile --find-links dist --prefix=/usr --root "$pkgdir" packaging
}
