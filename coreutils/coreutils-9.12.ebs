#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=coreutils
pkgver=9.12
pkgsrc=https://ftp.gnu.org/gnu/coreutils/coreutils-$pkgver.tar.xz
pkgchecksum=sha256:a480198559733e9b3da999e90543ac6f888a2caa544d8d664c5a1f17e528e210
pkgdesc="standard file, shell, and text manipulation utilities of the GNU system"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-3.0-or-later"
pkghomepage="https://www.gnu.org/software/coreutils/"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man,info"
pkgprovides="system:coreutils"

build() {
    FORCE_UNSAFE_CONFIGURE=1 ./configure ${CONFIGUREFLAGS:-} --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --without-selinux --with-openssl=no --disable-rpath --enable-no-install-program=hostname,kill,uptime,su
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
    rm -f "$pkgdir/usr/share/info/dir"
}
