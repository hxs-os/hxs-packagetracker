#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=zstd
pkgver=1.5.7
pkgsrc=https://github.com/facebook/zstd/releases/download/v$pkgver/zstd-$pkgver.tar.gz
pkgchecksum=sha256:eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3
pkgdesc="fast real-time compression algorithm"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="BSD-3-Clause OR GPL-2.0-only"
pkghomepage="https://facebook.github.io/zstd"
pkgcheck=true
pkgdeps="musl"
pkgprovides="libzstd"

build() {
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir" prefix=/usr
}
