#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=inetutils
pkgver=2.8
pkgsrc=https://ftp.gnu.org/gnu/inetutils/inetutils-$pkgver.tar.gz
pkgchecksum=sha256:57b3cf4f77555992881e5ba2a09a63b05aa2c56342a60ed4305b5f45938390b5
pkgdesc="traditional network clients, servers, and utilities"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-3.0-or-later"
pkghomepage="https://gnu.org/software/inetutils"
pkgcheck=true
pkgdeps="musl"
pkgtriggers="man,info"

build() {
    ./configure ${CONFIGUREFLAGS:-} --prefix=/usr --sysconfdir=/etc --localstatedir=/etc \
        --disable-rpath --enable-year2038
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir"
}
