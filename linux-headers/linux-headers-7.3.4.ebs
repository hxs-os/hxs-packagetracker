#!/bin/sh

#ebs.formulae
ebsver=1

pkgname=linux-headers
pkgver=7.3.4
pkgsrc=https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz
pkgchecksum=sha256:b11b6df8295e8e991ff040b71aaa4994a8b55caa23b6b092907f195b5840fd1f
pkgdesc="headers for linux kernel interfaces"
pkgmaintainer="juanvel400 <me@juanvel400.com>"
pkglicense="GPL-2.0-only WITH Linux-syscall-note"
pkghomepage="https://kernel.org"
pkgcheck=false

build() {
    make headers
}

package() {
    find usr/include -type f ! -name '*.h' -delete
    mkdir -p "$pkgdir/usr"
    cp -rv usr/include "$pkgdir/usr"
}
